{
  "name": "shoebox-streamer",
  "version": "0.2.0",
  "description": "Run it in a folder of videos and watch them from any device on your network: phone-friendly web player, smart transcoding, show detection, torrents and VLC.",
  "type": "module",
  "bin": {
    "shoebox": "bin/shoebox.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/shoebox.js",
    "test": "node --test"
  },
  "keywords": [
    "video",
    "streaming",
    "media-server",
    "lan",
    "hls",
    "transcode",
    "ffmpeg",
    "torrent",
    "mdns"
  ],
  "license": "MIT",
  "author": "Anam Ahmed <anam.ahmed.a@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theanam/shoebox-streamer.git"
  },
  "homepage": "https://github.com/theanam/shoebox-streamer#readme",
  "bugs": {
    "url": "https://github.com/theanam/shoebox-streamer/issues"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "hls.js": "^1.6.0",
    "qrcode-terminal": "^0.12.0",
    "uint8-util": "2.2.6"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "webtorrent": "^2.5.0"
  }
}
